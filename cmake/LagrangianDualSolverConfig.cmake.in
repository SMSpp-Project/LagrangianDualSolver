get_filename_component(LagrangianDualSolver_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include(CMakeFindDependencyMacro)

# ----- Requirements -------------------------------------------------------- #
find_dependency(SMSpp)
find_dependency(BundleSolver)

# ----- Import target ------------------------------------------------------- #
if (NOT TARGET SMS++::LagrangianDualSolver)
    include("${LagrangianDualSolver_CMAKE_DIR}/LagrangianDualSolverTargets.cmake")
endif ()

set(LagrangianDualSolver_LIBRARIES SMS++::LagrangianDualSolver)
